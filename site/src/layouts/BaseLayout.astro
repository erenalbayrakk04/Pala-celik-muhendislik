---
// Bütün sayfaların ortak iskeleti: <head> bilgileri, üst menü, alt bilgi ve sağ alttaki iletişim butonları.
// Yeni bir sayfa yaparken içeriği <BaseLayout> ... </BaseLayout> arasına yazman yeterli.
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IletisimButonlari from '../components/IletisimButonlari.astro';
import { firma, sayfaYolu } from '../data/site';

interface Props {
  baslik?: string; // tarayıcı sekmesinde ve Google'da görünen başlık
  aciklama?: string; // Google sonuçlarında başlığın altında görünen açıklama
}

const {
  baslik = `${firma.ad} | Çelik Çatı, Uzay Çatı ve Çelik İmalat`,
  aciklama = "Sarıyer, İstanbul. Çelik çatı, uzay çatı, çelik konstrüksiyon ev, asma tavan, bölme duvar ve projeye özel çelik imalat. WhatsApp'tan hemen teklif alın.",
} = Astro.props;

const adres = new URL(sayfaYolu(Astro.url), Astro.site);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{baslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={adres} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#131316" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={firma.ad} />
    <meta property="og:title" content={baslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={adres} />
    <meta property="og:image" content={new URL('/og-gorsel.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#icerik">İçeriğe geç</a>
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
    <IletisimButonlari />
  </body>
</html>
