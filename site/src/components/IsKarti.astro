---
// Tek bir "yapılan iş" kartı: kare fotoğraf, üstünde başlık ve bölüm adı. Tıklanınca işin sayfası açılır.
import SanityResim from './SanityResim.astro';
import Ikon from './Ikon.astro';
import type { YapilanIs } from '../lib/icerik';

interface Props {
  is: YapilanIs;
  bolumGoster?: boolean;
  ilkGorunen?: boolean; // sayfanın üstündeyse hemen yüklensin
}

const { is, bolumGoster = true, ilkGorunen = false } = Astro.props;
---

<a class="is" href={`/yapilan-isler/${is.slug}`}>
  {
    is.kapak && (
      <SanityResim
        gorsel={is.kapak}
        alt={is.baslik}
        genislik={600}
        oran={1}
        sizes="(max-width: 767px) 50vw, (max-width: 1240px) 33vw, 400px"
        loading={ilkGorunen ? 'eager' : 'lazy'}
      />
    )
  }
  {
    is.video && (
      <span class="is__video" title="Videosu var">
        <Ikon ad="play" />
        <span class="sr-only">Videosu var</span>
      </span>
    )
  }
  <span class="is__yazi">
    {bolumGoster && is.hizmet && <span class="is__bolum">{is.hizmet.baslik}</span>}
    <span class="is__baslik">{is.baslik}</span>
  </span>
</a>

<style>
  .is {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--ink-2);
    color: var(--white);
  }
  .is :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .is:hover :global(img) {
    transform: scale(1.05);
  }
  .is__video {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
  }
  .is__video :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .is__yazi {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.15rem;
    padding: 3rem 1rem 0.9rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.65) 45%, rgb(0 0 0 / 0.9));
  }
  .is__bolum {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--spark);
  }
  .is__baslik {
    font-weight: 600;
    line-height: 1.3;
  }
  @media (max-width: 479px) {
    .is__yazi {
      padding: 2.5rem 0.75rem 0.7rem;
      font-size: 0.95rem;
    }
    /* Telefonda küçük kartlarda bölüm adı yer kaplamasın */
    .is__bolum {
      display: none;
    }
  }
</style>
